{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astro-archive.local/schemas/ai-dataset-v1.json",
  "title": "Astro Archive AI dataset manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "datasetId",
    "version",
    "createdAt",
    "labelSchema",
    "status",
    "exampleCount",
    "hash",
    "splits",
    "frames",
    "labelers",
    "provenance"
  ],
  "properties": {
    "schema": {"const": "astro-ai-dataset-v1"},
    "datasetId": {"type": "string", "minLength": 1, "maxLength": 120},
    "version": {"type": "string", "minLength": 1, "maxLength": 64},
    "createdAt": {"type": "string", "format": "date-time"},
    "labelSchema": {"const": "astro-ai-labels-v1"},
    "status": {"enum": ["draft", "frozen"]},
    "frozenAt": {"type": ["string", "null"], "format": "date-time"},
    "exampleCount": {"type": "integer", "minimum": 0},
    "hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "splits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train", "validation", "test", "unassigned"],
      "properties": {
        "train": {"type": "integer", "minimum": 0},
        "validation": {"type": "integer", "minimum": 0},
        "test": {"type": "integer", "minimum": 0},
        "unassigned": {"type": "integer", "minimum": 0}
      }
    },
    "frames": {
      "type": "array",
      "maxItems": 100000,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 120}
    },
    "labelers": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 120}
    },
    "exclusions": {
      "type": "array",
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/exclusion"}
    },
    "overrides": {
      "type": "array",
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/override"}
    },
    "stats": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {"type": ["integer", "number", "null"]}
      }
    },
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frameId", "reason"],
      "properties": {
        "frameId": {"type": "string", "minLength": 1, "maxLength": 120},
        "reason": {"type": "string", "minLength": 1, "maxLength": 400}
      }
    },
    "override": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exampleId", "field", "value", "reason", "createdAt"],
      "properties": {
        "exampleId": {"type": "string", "minLength": 1, "maxLength": 120},
        "field": {
          "enum": ["quality", "cloud", "trail", "light", "elongation", "defocus", "defects", "artifacts", "objects", "_record"]
        },
        "value": {},
        "reason": {"type": "string", "minLength": 1, "maxLength": 400},
        "actor": {"type": ["string", "null"], "maxLength": 120},
        "createdAt": {"type": "string", "format": "date-time"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "exportedAt"],
      "properties": {
        "source": {"enum": ["astro-archive", "import", "legacy"]},
        "exportedAt": {"type": "string", "format": "date-time"},
        "exportedBy": {"type": ["string", "null"], "maxLength": 200},
        "filters": {"type": "object", "additionalProperties": true},
        "notes": {"type": "string", "maxLength": 2000}
      }
    }
  }
}
