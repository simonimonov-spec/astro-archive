{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astro-archive.local/schemas/ai-model-v1.json",
  "title": "Astro Archive AI MLP model v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "modelId",
    "version",
    "createdAt",
    "featureSchema",
    "input",
    "hidden",
    "output",
    "training",
    "provenance"
  ],
  "properties": {
    "format": {"const": "astro-ai-mlp-v1"},
    "modelId": {"type": "string", "minLength": 1, "maxLength": 120},
    "version": {"type": "string", "minLength": 1, "maxLength": 64},
    "createdAt": {"type": "string", "format": "date-time"},
    "featureSchema": {"type": "string", "minLength": 1, "maxLength": 120},
    "input": {"$ref": "#/$defs/input"},
    "hidden": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/layer"}
    },
    "output": {"$ref": "#/$defs/output"},
    "training": {"$ref": "#/$defs/training"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "metrics": {"type": "object"}
  },
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["names", "mean", "scale"],
      "properties": {
        "names": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {"type": "string", "minLength": 1, "maxLength": 120}
        },
        "mean": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {"type": "number"}
        },
        "scale": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activation", "weights", "biases"],
      "properties": {
        "activation": {"enum": ["relu", "tanh", "sigmoid", "linear"]},
        "weights": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {"type": "number"}
          }
        },
        "biases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {"type": "number"}
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activation", "weights", "biases", "names"],
      "properties": {
        "activation": {"enum": ["sigmoid", "linear"]},
        "weights": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {"type": "number"}
          }
        },
        "biases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"type": "number"}
        },
        "names": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "enum": [
              "quality",
              "risk.noise",
              "risk.stars",
              "risk.defects",
              "risk.trails",
              "risk.objects",
              "risk.light",
              "risk.artifacts",
              "event.cloud",
              "event.satellite",
              "event.obstruction"
            ]
          }
        }
      }
    },
    "training": {
      "type": "object",
      "additionalProperties": false,
      "required": ["datasetId", "datasetHash", "exampleCount", "seed", "codeVersion"],
      "properties": {
        "datasetId": {"type": "string", "minLength": 1, "maxLength": 120},
        "datasetHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "exampleCount": {"type": "integer", "minimum": 1},
        "seed": {"type": "integer", "minimum": 0},
        "codeVersion": {"type": "string", "minLength": 1, "maxLength": 120},
        "metrics": {"type": "object", "additionalProperties": true},
        "splits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "train": {"type": "integer", "minimum": 0},
            "validation": {"type": "integer", "minimum": 0},
            "test": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["createdBy", "legacy"],
      "properties": {
        "createdBy": {"type": "string", "minLength": 1, "maxLength": 200},
        "legacy": {"type": "boolean"},
        "notes": {"type": "string", "maxLength": 2000}
      }
    }
  }
}
