{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Astro Archive FITS ResNet model v1",
  "type": "object", "additionalProperties": false,
  "required": ["format", "architecture", "featureSchema", "modelId", "version", "createdAt", "preprocessing", "input", "heads", "weights", "training", "metrics", "provenance"],
  "properties": {
    "format": {"const": "astro-ai-resnet-v1"},
    "architecture": {"const": "resnet18-gn-width16-native-v1"},
    "featureSchema": {"const": "astro-ai-visual-measurements-v1"},
    "modelId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"},
    "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "createdAt": {"type": "string", "format": "date-time"},
    "preprocessing": {"type": "object", "additionalProperties": false, "required": ["schema", "tileSize", "stride", "maxTiles"], "properties": {
      "schema": {"const": "astro-fits-native-asinh-v1"}, "tileSize": {"enum": [64,128,256]}, "stride": {"type": "integer", "minimum": 1, "maximum": 256}, "maxTiles": {"const": 4096}
    }},
    "input": {"type": "object", "additionalProperties": false, "required": ["names", "mean", "scale"], "properties": {
      "names": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
      "mean": {"type": "array", "items": {"type": "number"}},
      "scale": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}}
    }},
    "heads": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"enum": ["quality", "risk.noise", "risk.stars", "risk.defects", "risk.trails", "risk.light", "risk.artifacts", "event.cloud", "event.satellite", "event.obstruction"]}},
    "weights": {"type": "object", "additionalProperties": false, "required": ["hash", "size"], "properties": {
      "hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "size": {"type": "integer", "minimum": 1, "maximum": 16000000}
    }},
    "training": {"type": "object"}, "metrics": {"type": "object"}, "provenance": {"type": "object"}
  }
}
