{
  "apiVersion": 1,
  "id": "shared-archives",
  "name": "Shared Archives · LAN",
  "version": "V-2.2",
  "description": "Споделени архиви за кадри, стакове и снимки между копия на Astro Archive през LAN или VPN. Свързване с еднократен код, позволени устройства и шифрован трафик.",
  "author": "Astro Archive",
  "entry": "main.py",
  "permissions": [
    "archive.manage"
  ],
  "logo": "logo.png",
  "contributions": [
    {
      "id": "local-sharing",
      "slot": "settings",
      "title": "Shared Archives · Връзки между приложенията",
      "clients": ["desktop"]
    },
    {
      "id": "archive-source",
      "slot": "anchor",
      "anchor": "archive.location",
      "mode": "append",
      "presentation": "inline",
      "title": "Споделен архив",
      "archiveIds": ["frames", "stacks", "photos"],
      "clients": ["desktop"]
    },
    {
      "id": "network",
      "slot": "settings",
      "title": "Shared Archives · Windows SMB",
      "clients": [
        "desktop"
      ]
    },
    {
      "id": "state",
      "slot": "header",
      "title": "Споделени LAN архиви",
      "clients": [
        "desktop"
      ]
    }
  ],
  "capabilities": [
    {
      "id": "archives.sharing.source",
      "command": "local-source",
      "name": "Каталог и файлове на споделен архив"
    },
    {
      "id": "archives.sharing.status",
      "command": "status",
      "name": "Състояние на шифрованото LAN споделяне"
    }
  ]
}
