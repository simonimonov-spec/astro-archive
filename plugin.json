{
  "apiVersion": 1,
  "id": "shared-archives",
  "name": "Shared Archives · LAN",
  "version": "V-2",
  "description": "Споделяне на архиви през шифрован SMB 3 в LAN и пробен режим за автоматично откриване, преглед и защитен запис между две копия на Astro Archive на един Windows компютър.",
  "author": "Astro Archive",
  "entry": "main.py",
  "permissions": [
    "archive.manage"
  ],
  "logo": "logo.png",
  "contributions": [
    {
      "id": "local-sharing",
      "slot": "settings",
      "title": "Shared Archives · Проба на този компютър",
      "clients": ["desktop"]
    },
    {
      "id": "archive-source",
      "slot": "anchor",
      "anchor": "archive.location",
      "mode": "append",
      "presentation": "inline",
      "title": "Споделен архив",
      "archiveIds": ["frames", "stacks", "photos"],
      "clients": ["desktop"]
    },
    {
      "id": "network",
      "slot": "settings",
      "title": "Shared Archives · хост и връзки",
      "clients": [
        "desktop"
      ]
    },
    {
      "id": "state",
      "slot": "header",
      "title": "Споделени LAN архиви",
      "clients": [
        "desktop"
      ]
    }
  ],
  "capabilities": [
    {
      "id": "archives.sharing.source",
      "command": "local-source",
      "name": "Каталог и файлове на споделен архив"
    },
    {
      "id": "archives.sharing.status",
      "command": "status",
      "name": "Състояние на шифрованото LAN споделяне"
    }
  ]
}
